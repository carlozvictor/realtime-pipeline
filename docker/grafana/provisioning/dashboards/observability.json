{
  "title": "Pipeline Observability",
  "uid": "bsky-pipeline-observability",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Kafka consumer lag (flink-analytics)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kafka_consumergroup_lag{consumergroup=\"flink-analytics\"}",
          "legendFormat": "{{topic}} / partition {{partition}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Throughput por estagio (registros/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flink_taskmanager_job_task_numRecordsInPerSecond",
          "legendFormat": "{{task_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Duracao do checkpoint (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flink_jobmanager_job_lastCheckpointDuration",
          "legendFormat": "duracao",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tamanho do checkpoint (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flink_jobmanager_job_lastCheckpointSize",
          "legendFormat": "tamanho",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Restarts do job",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flink_jobmanager_job_numRestarts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Checkpoints com falha",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flink_jobmanager_job_numberOfFailedCheckpoints",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Checkpoints completados",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flink_jobmanager_job_numberOfCompletedCheckpoints",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Tasks com backpressure",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(flink_taskmanager_job_task_isBackPressured)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      }
    }
  ]
}
